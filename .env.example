# ==============================================================================
# CFC–ZEO AI Chatbot Environment Variables
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (Docker default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cfc_zeo_db
POSTGRES_USER=cfc_admin
POSTGRES_PASSWORD=cfc_secret_password
DATABASE_URL=postgresql+asyncpg://cfc_admin:cfc_secret_password@localhost:5432/cfc_zeo_db

# Redis (Docker default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_TAG=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=15.0

# Meta Messenger — Page CFC (Cò Bay)
CFC_PAGE_ID=your_cfc_page_id
CFC_VERIFY_TOKEN=your_cfc_webhook_verify_token
CFC_APP_SECRET=your_cfc_meta_app_secret
CFC_PAGE_ACCESS_TOKEN=your_cfc_page_access_token

# Meta Messenger — Page ZEO (Zeolite)
ZEO_PAGE_ID=your_zeo_page_id
ZEO_VERIFY_TOKEN=your_zeo_webhook_verify_token
ZEO_APP_SECRET=your_zeo_meta_app_secret
ZEO_PAGE_ACCESS_TOKEN=your_zeo_page_access_token

# Messaging & Aggregator
DEBOUNCE_SECONDS=5.0
MAX_BATCH_SECONDS=20.0

# MISA AMIS CRM Integration (Replaces n8n sync)
AMIS_BASE_URL=https://crmconnect.misa.vn/api/v2
AMIS_CLIENT_ID=JavisCFCChatbot
AMIS_CLIENT_SECRET=your_misa_client_secret
AMIS_SYNC_INTERNAL_TOKEN=your_secure_internal_token
AMIS_PILOT_APPROVE_ALL=true
