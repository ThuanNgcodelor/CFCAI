# ==============================================================================
# CFC–ZEO AI Chatbot Environment Variables
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Mandatory for /admin when ENVIRONMENT is staging/production. Keep it in a
# secret manager in real deployments; never commit the real value.
ADMIN_API_TOKEN=replace_with_admin_api_token
# Optional least-privilege tokens, JSON mapping role -> secret. Valid roles:
# viewer, operator, publisher. ADMIN_API_TOKEN remains break-glass admin.
ADMIN_ROLE_TOKENS_JSON=

# PostgreSQL (Docker default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cfc_zeo_db
POSTGRES_USER=cfc_admin
POSTGRES_PASSWORD=cfc_secret_password
DATABASE_URL=postgresql+asyncpg://cfc_admin:cfc_secret_password@localhost:5432/cfc_zeo_db
INBOX_BACKEND=postgres

# Redis (Docker default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_TAG=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=15.0
INTENT_NORMALIZATION_PATH=config/normalization/vi_intent.json
ADMINISTRATIVE_AREAS_PATH=config/normalization/administrative_areas.json
MARKDOWN_CATALOG_MAPPING_PATH=config/data_sources/markdown_mapping.json
SUPPORT_CONTACTS_PATH=config/business/support_contacts.json

# Meta Messenger — Page CFC (Cò Bay)
CFC_PAGE_ID=your_cfc_page_id
CFC_VERIFY_TOKEN=replace_with_cfc_verify_token
CFC_APP_SECRET=replace_with_cfc_app_secret
CFC_PAGE_ACCESS_TOKEN=your_cfc_page_access_token

# Meta Messenger — Page ZEO (Zeolite)
ZEO_PAGE_ID=your_zeo_page_id
ZEO_VERIFY_TOKEN=replace_with_zeo_verify_token
ZEO_APP_SECRET=replace_with_zeo_app_secret
ZEO_PAGE_ACCESS_TOKEN=your_zeo_page_access_token

# Messaging & Aggregator
DEBOUNCE_SECONDS=5.0
MAX_BATCH_SECONDS=20.0
META_SEND_ENABLED=false
META_TEST_RECIPIENT_ID=
# disabled -> no send; shadow -> record/suppress; canary/live require explicit
# approval flags plus the scoped configuration below.
DELIVERY_MODE=disabled
CANARY_PAGE_IDS=
CANARY_WORKFLOWS=
CANARY_RECIPIENT_IDS=
CANARY_PERCENT=0
CANARY_SEND_APPROVED=false
LIVE_SEND_APPROVED=false
# Mandatory before canary/live: no outbox row created before this timestamp may
# be sent after a rollout switch. Example: 2026-10-27T09:00:00+07:00
DELIVERY_NOT_BEFORE=

# MISA AMIS CRM Integration (Replaces n8n sync)
AMIS_BASE_URL=https://crmconnect.misa.vn/api/v2
AMIS_CLIENT_ID=JavisCFCChatbot
AMIS_CLIENT_SECRET=your_misa_client_secret
AMIS_SYNC_INTERNAL_TOKEN=your_secure_internal_token
AMIS_PILOT_APPROVE_ALL=false
AMIS_SYNC_INTERVAL_SECONDS=3600
AMIS_SYNC_LOCK_SECONDS=900
AMIS_SNAPSHOT_RETENTION_SECONDS=604800
AMIS_SYNC_FRESHNESS_SECONDS=5400

# Configuration-driven source bootstrap
DATA_SOURCE_MANIFEST_PATH=data/sources/manifest.yaml
